<?xml version="1.0" encoding="UTF-8"?>
<!-- The zip must hold <skillName>/SKILL.md at its root: the advisor unpacks the folder named after the skill. -->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 https://maven.apache.org/xsd/assembly-2.0.0.xsd">
  <id>skills</id>
  <formats>
    <format>zip</format>
  </formats>
  <baseDirectory></baseDirectory>
  <fileSets>
    <fileSet>
      <directory>skills</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
